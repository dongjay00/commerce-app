{
  "name": "commerce-app",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project api-unit",
    "test:int": "vitest run --project api-integration",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @commerce/api db:migrate",
    "db:generate": "pnpm --filter @commerce/api db:generate",
    "arch:check": "depcruise --config .dependency-cruiser.js apps packages",
    "arch:graph": "depcruise --config .dependency-cruiser.js --output-type dot apps packages > docs/architecture.dot || true; dot -Tsvg docs/architecture.dot > docs/architecture.svg && rm docs/architecture.dot",
    "verify": "pnpm lint && pnpm arch:check && pnpm typecheck && pnpm -r --if-present build && pnpm test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@swc/core": "^1.16.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.0",
    "dependency-cruiser": "^18.2.0",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "pg": "^8.23.0",
    "typescript": "^5.6.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^3.2.0"
  }
}
